APP_NAME="SourceCat"
APP_ENV=production
APP_DEBUG=false
APP_PORT=8000
APP_URL=https://blog.example.com
APP_KEY=REPLACE_WITH_RANDOM_SECRET
SECRET_KEY_BASE=REPLACE_WITH_ANOTHER_RANDOM_SECRET
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_DATABASE=/var/lib/glimr/blog.sqlite
DB_POOL_SIZE=15
CACHE_PATH=/var/lib/glimr/cache
