# Build SQLite's native library on the same OTP/Alpine base as the runtime.
ARG OTP_IMAGE=erlang:29.0.6-alpine
FROM ghcr.io/gleam-lang/gleam:v1.18.1-erlang-alpine AS gleam
FROM node:24-alpine AS frontend
WORKDIR /source
COPY package.json package-lock.json ./
RUN npm ci
COPY vite.config.ts tsconfig.json ./
COPY src/resources ./src/resources
COPY priv/static/images ./priv/static/images
RUN npm run build

FROM ${OTP_IMAGE} AS backend
COPY --from=gleam /bin/gleam /usr/local/bin/gleam
RUN apk add --no-cache bash build-base git linux-headers
WORKDIR /source
COPY gleam.toml manifest.toml ./
RUN gleam deps download
COPY config ./config
COPY src ./src
# Call the build module directly: the CLI registry is generated by this command.
RUN gleam run -m glimr/internal/console/commands/build
RUN gleam export erlang-shipment
RUN cp -R config build/erlang-shipment/config \
    && cp src/database/main/_migrations/20260312201116_create_session_table.sql build/erlang-shipment/sessions.sql

FROM ${OTP_IMAGE} AS runtime
RUN apk add --no-cache sqlite su-exec \
    && addgroup -S -g 10001 webapp \
    && adduser -S -D -H -u 10001 -G webapp webapp
WORKDIR /app
COPY --from=backend /source/build/erlang-shipment ./
COPY --from=frontend /source/priv/static ./priv/static
COPY deploy/fly-entrypoint.sh ./fly-entrypoint.sh
ENV APP_NAME=SourceCat APP_ENV=production APP_DEBUG=false \
    APP_BIND=0.0.0.0 APP_PORT=8000 DB_POOL_SIZE=1 \
    DB_DATABASE=/data/sourcecat.sqlite CACHE_PATH=/data/cache
EXPOSE 8000
# Volume ownership/schema setup runs as root; the HTTP process runs as webapp.
ENTRYPOINT ["/bin/sh", "/app/fly-entrypoint.sh"]
CMD ["run"]
